# MongoDB data directory on the host (bind mount)
# Default: ./mongo-data (relative to this compose file)
# Override in .env (git-ignored), e.g. MONGO_DATA_PATH=D:/data/monei.it_database
MONGO_DATA_PATH=./mongo-data

# SQL Server container: data folder and the folder holding the .bak restore files
SQL_DATA_PATH=./sql-data
SQL_BACKUP_PATH=./sql-backup
